<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>نظام إدارة محل الهواتف الذكي - ليبانون</title>
    <style>
        :root {
            --bg-gradient: linear-gradient(135deg, #0f172a 0%, #1e1b4b 50%, #311042 100%);
            --glass-bg: rgba(255, 255, 255, 0.05);
            --glass-border: rgba(255, 255, 255, 0.1);
            --glass-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.37);
            --text-primary: #f8fafc;
            --text-secondary: #94a3b8;
            --accent-alpha: #00d2ff;
            --accent-mtc: #ff4b2b;
            --accent-wish: #10b981;
            --radius: 20px;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        body {
            background: var(--bg-gradient);
            color: var(--text-primary);
            min-height: 100vh;
            padding: 20px;
            display: flex;
            justify-content: center;
            align-items: center;
        }

        .app-container {
            width: 100%;
            max-width: 1200px;
            background: var(--glass-bg);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border: 1px solid var(--glass-border);
            border-radius: var(--radius);
            box-shadow: var(--glass-shadow);
            overflow: hidden;
            display: grid;
            grid-template-columns: 260px 1fr;
            min-height: 750px;
        }

        /* Sidebar Styling */
        .sidebar {
            background: rgba(0, 0, 0, 0.2);
            border-left: 1px solid var(--glass-border);
            padding: 30px 20px;
            display: flex;
            flex-direction: column;
            gap: 20px;
        }

        .logo {
            font-size: 1.2rem;
            font-weight: bold;
            color: var(--text-primary);
            text-align: center;
            margin-bottom: 20px;
            letter-spacing: 1px;
        }

        .nav-btn {
            background: transparent;
            border: none;
            color: var(--text-secondary);
            padding: 12px 18px;
            border-radius: 12px;
            text-align: right;
            cursor: pointer;
            font-size: 0.95rem;
            transition: all 0.3s ease;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .nav-btn:hover, .nav-btn.active {
            background: rgba(255, 255, 255, 0.1);
            color: var(--text-primary);
            transform: translateX(-5px);
        }

        /* Main Content Styling */
        .main-content {
            padding: 30px;
            overflow-y: auto;
            max-height: 80vh;
        }

        .header-dash {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 30px;
        }

        .balance-card {
            background: rgba(255, 255, 255, 0.03);
            border: 1px solid var(--glass-border);
            padding: 15px 25px;
            border-radius: 14px;
            display: flex;
            align-items: center;
            gap: 15px;
        }

        .balance-card h4 {
            font-size: 0.85rem;
            color: var(--text-secondary);
        }

        .balance-card span {
            font-size: 1.2rem;
            font-weight: bold;
            color: var(--accent-wish);
        }

        /* Grid Cards */
        .grid-cards {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 20px;
            margin-bottom: 30px;
        }

        .card {
            background: rgba(255, 255, 255, 0.04);
            border: 1px solid var(--glass-border);
            border-radius: var(--radius);
            padding: 20px;
            transition: 0.3s;
        }

        .card:hover {
            border-color: rgba(255, 255, 255, 0.3);
            transform: translateY(-3px);
        }

        .card h3 {
            font-size: 1.1rem;
            margin-bottom: 15px;
            color: var(--text-primary);
        }

        /* Form Controls */
        .form-group {
            margin-bottom: 15px;
        }

        .form-group label {
            display: block;
            font-size: 0.85rem;
            color: var(--text-secondary);
            margin-bottom: 5px;
        }

        .form-control {
            width: 100%;
            padding: 10px 15px;
            background: rgba(0, 0, 0, 0.2);
            border: 1px solid var(--glass-border);
            border-radius: 10px;
            color: var(--text-primary);
            outline: none;
            font-size: 0.95rem;
        }

        .form-control:focus {
            border-color: var(--accent-alpha);
        }

        .btn {
            background: linear-gradient(135deg, #3b82f6, #1d4ed8);
            color: white;
            border: none;
            padding: 10px 20px;
            border-radius: 10px;
            cursor: pointer;
            font-weight: bold;
            width: 100%;
            transition: 0.2s;
        }

        .btn:hover {
            opacity: 0.9;
        }

        .btn-wish {
            background: linear-gradient(135deg, #10b981, #047857);
        }

        /* Responsive */
        @media(max-width: 768px) {
            .app-container {
                grid-template-columns: 1fr;
            }
            .sidebar {
                flex-direction: row;
                overflow-x: auto;
                padding: 15px;
            }
        }
    </style>
</head>
<body>

    <div class="app-container">
        <!-- الشريط الجانبي -->
        <div class="sidebar">
            <div class="logo">⚡ Smart POS LB</div>
            <button class="nav-btn active">📊 الرئيسية والخطوط</button>
            <button class="nav-btn">🔄 خدمة ألفا يوشير (U-Share)</button>
            <button class="nav-btn">📱 تعبئة أيام وصلاحية</button>
            <button class="nav-btn">💵 فواتير شراء الهواتف</button>
            <button class="nav-btn">💳 شحن عبر Wish Money</button>
        </div>

        <!-- المحتوى الرئيسي -->
        <div class="main-content">
            <div class="header-dash">
                <h2>لوحة التحكم والتشريج الذكية</h2>
                <div class="balance-card">
                    <div>
                        <h4>رصيد تطبيق وش ماني المدمج:</h4>
                        <span id="wish-balance">$450.00</span>
                    </div>
                </div>
            </div>

            <!-- أقسام الخدمات السريعة -->
            <div class="grid-cards">
                <!-- قسم تشريج ألفا و MTC -->
                <div class="card">
                    <h3>⚡ تشريج خطوط (ألفا / MTC)</h3>
                    <div class="form-group">
                        <label>اختر الشبكة</label>
                        <select class="form-control">
                            <option>ألفا (Alfa)</option>
                            <option>إم تسي (MTC Touch)</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label>رقم الهاتف</label>
                        <input type="text" class="form-control" placeholder="70xxxxxx أو 71xxxxxx">
                    </div>
                    <div class="form-group">
                        <label>نوع الكارت / القيمة</label>
                        <select class="form-control">
                            <option>كارت عادي ($7.50 / $15 / $22.86)</option>
                            <option>تعبئة أيام صالحة (Validity)</option>
                        </select>
                    </div>
                    <button class="btn">تنفيذ التشريج الآن</button>
                </div>

                <!-- قسم ألفا يوشير -->
                <div class="card" style="border-color: rgba(0, 210, 255, 0.3);">
                    <h3>🔄 خدمة ألفا يوشير (U-Share)</h3>
                    <div class="form-group">
                        <label>رقم المرسل (المحل)</label>
                        <input type="text" class="form-control" placeholder="رقم خط ألفا الخاص بك">
                    </div>
                    <div class="form-group">
                        <label>رقم الزبون المستلم</label>
                        <input type="text" class="form-control" placeholder="رقم الزبون">
                    </div>
                    <div class="form-group">
                        <label>المبلغ المراد تحويله ($)</label>
                        <input type="number" class="form-control" placeholder="مثال: $5">
                    </div>
                    <button class="btn" style="background: linear-gradient(135deg, #00d2ff, #3a7bd5);">تحويل يوشير فوري</button>
                </div>

                <!-- قسم ربط وش ماني وشراء رصيد -->
                <div class="card">
                    <h3>💳 تعبئة الرصيد (Wish Money API)</h3>
                    <p style="font-size: 0.85rem; color: var(--text-secondary); margin-bottom: 15px;">قم بربط محفظتك لشحن رصيد النظام تلقائياً.</p>
                    <div class="form-group">
                        <label>قيمة الشحن ($)</label>
                        <input type="number" class="form-control" value="100">
                    </div>
                    <button class="btn btn-wish">إتمام الدفع عبر Wish Money</button>
                </div>

                <!-- قسم فواتير الهواتف -->
                <div class="card">
                    <h3>📱 فاتورة شراء هاتف جديد</h3>
                    <div class="form-group">
                        <label>اسم الزبون / الهاتف</label>
                        <input type="text" class="form-control" placeholder="مثل: iPhone 13 - أحمد علي">
                    </div>
                    <div class="form-group">
                        <label>السعر الإجمالي ($)</label>
                        <input type="number" class="form-control" placeholder="0.00">
                    </div>
                    <button class="btn" style="background: linear-gradient(135deg, #8b5cf6, #6d28d9);">اصدار وحفظ الفاتورة</button>
                </div>
            </div>
        </div>
    </div>

</body>
</html>
